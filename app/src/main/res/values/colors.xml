<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material 3 基线配色(浅色)。
      开启「莫奈取色」后,整套角色由 DynamicColors 用系统壁纸取色覆盖,
      因此这里只负责兜底:未开启取色、或系统低于 Android 12 时使用。

      命名沿用 md_* 前缀,日/夜两份文件同名同结构,
      由资源限定符自动切换,主题里不再区分 _dark 后缀。
    -->

    <!-- Primary -->
    <color name="md_primary">#6750A4</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#EADDFF</color>
    <color name="md_on_primary_container">#21005D</color>

    <!-- Secondary -->
    <color name="md_secondary">#625B71</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#E8DEF8</color>
    <color name="md_on_secondary_container">#1D192B</color>

    <!-- Tertiary -->
    <color name="md_tertiary">#7D5260</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#FFD8E4</color>
    <color name="md_on_tertiary_container">#31111D</color>

    <!-- Error -->
    <color name="md_error">#B3261E</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#F9DEDC</color>
    <color name="md_on_error_container">#410E0B</color>

    <!-- Background / Surface -->
    <color name="md_background">#FEF7FF</color>
    <color name="md_on_background">#1D1B20</color>
    <color name="md_surface">#FEF7FF</color>
    <color name="md_on_surface">#1D1B20</color>
    <color name="md_surface_variant">#E7E0EC</color>
    <color name="md_on_surface_variant">#49454F</color>
    <color name="md_surface_tint">#6750A4</color>

    <!-- Surface 容器层级(M3 elevation 语义) -->
    <color name="md_surface_container_lowest">#FFFFFF</color>
    <color name="md_surface_container_low">#F7F2FA</color>
    <color name="md_surface_container">#F3EDF7</color>
    <color name="md_surface_container_high">#ECE6F0</color>
    <color name="md_surface_container_highest">#E6E0E9</color>

    <!-- Outline -->
    <color name="md_outline">#79747E</color>
    <color name="md_outline_variant">#CAC4D0</color>

    <!-- 反色 / 遮罩 -->
    <color name="md_inverse_surface">#322F35</color>
    <color name="md_inverse_on_surface">#F5EFF7</color>
    <color name="md_inverse_primary">#D0BCFF</color>
    <color name="md_scrim">#000000</color>

    <!-- HTML 语法高亮(随日/夜切换) -->
    <color name="html_tag_color">#6A4BA8</color>
    <color name="html_attr_color">#B3261E</color>
    <color name="html_value_color">#2E6B48</color>
    <color name="html_text_color">#1D1B20</color>

    <!-- 兼容既有引用 -->
    <color name="expand_btn_bg">#EADDFF</color>
</resources>
