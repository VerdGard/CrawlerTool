<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context="com.SoloSu.Crawler_tool.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="2dp"
        android:background="?attr/colorSurfaceContainerLow">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurfaceContainerLow"
            app:title="Crawler Tool"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:titleTextColor="?attr/colorOnSurface"
            />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:clipToPadding="false">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:contentPadding="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 模式选择 -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/modeChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:chipSpacing="6dp"
                    app:checkedChip="@id/chipModeXPath">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeXPath"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_xpath" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeCss"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_css" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeRegex"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_regex" />

                </com.google.android.material.chip.ChipGroup>

                <!-- URL输入 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/urlInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/hint_url"
                    app:boxStrokeWidth="1.5dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 表达式输入 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/exprInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:hint="@string/hint_xpath"
                    app:boxStrokeWidth="1.5dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExpression"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 快捷属性标签 -->
                <TextView
                    android:id="@+id/tvQuickAttrs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_quick_attrs"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="4dp" />

                <HorizontalScrollView
                    android:id="@+id/quickAttrScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:scrollbars="none"
                    android:overScrollMode="ifContentScrolls">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/quickAttrChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:chipSpacing="4dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTitle"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="title"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:chipBackgroundColor="?attr/colorSurfaceVariant"
                            app:chipStrokeColor="?attr/colorOutline"
                            app:chipStrokeWidth="1dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:chipMinTouchTargetSize="28dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipHref"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="href"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:chipBackgroundColor="?attr/colorSurfaceVariant"
                            app:chipStrokeColor="?attr/colorOutline"
                            app:chipStrokeWidth="1dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:chipMinTouchTargetSize="28dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDataOriginal"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="data-original"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:chipBackgroundColor="?attr/colorSurfaceVariant"
                            app:chipStrokeColor="?attr/colorOutline"
                            app:chipStrokeWidth="1dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:chipMinTouchTargetSize="28dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDataSrc"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="data-src"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:chipBackgroundColor="?attr/colorSurfaceVariant"
                            app:chipStrokeColor="?attr/colorOutline"
                            app:chipStrokeWidth="1dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:chipMinTouchTargetSize="28dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipText"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="text()"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:chipBackgroundColor="?attr/colorSurfaceVariant"
                            app:chipStrokeColor="?attr/colorOutline"
                            app:chipStrokeWidth="1dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:chipMinTouchTargetSize="28dp" />

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

                <!-- 批量抓取展开区 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/batchSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:contentPadding="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/batch_title"
                            android:textSize="13sp"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:hint="@string/batch_start_page">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etBatchStart"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:hint="@string/batch_end_page">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etBatchEnd"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:hint="@string/batch_url_pattern">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBatchUrlPattern"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri"
                                android:singleLine="true"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBatchStart"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:text="@string/batch_btn_start"
                            android:textSize="12sp"
                            android:minHeight="0dp"
                            app:cornerRadius="18dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 操作按钮行(可横向滑动) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMatch"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginEnd="4dp"
                            android:text="@string/btn_match"
                            android:textSize="12sp"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:cornerRadius="22dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBatch"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginEnd="4dp"
                            android:text="批量"
                            android:textSize="12sp"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:cornerRadius="22dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClear"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginEnd="4dp"
                            android:text="@string/btn_clear"
                            android:textSize="12sp"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:cornerRadius="22dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPasteUrl"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="@string/btn_paste_url"
                            android:textSize="12sp"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:cornerRadius="22dp" />

                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 结果卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="4dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:contentPadding="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvResultTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="匹配结果"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_copy_rule"
                        android:textSize="11sp"
                        android:minHeight="0dp"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="12dp"
                        app:cornerRadius="16dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_marginBottom="6dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerResult"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:padding="2dp"
                    android:overScrollMode="ifContentScrolls"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- 分页 -->
                <LinearLayout
                    android:id="@+id/paginationBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone"
                    android:paddingTop="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrevPage"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="上一页"
                        android:textSize="11sp"
                        android:minHeight="0dp"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="12dp"
                        app:cornerRadius="16dp" />

                    <TextView
                        android:id="@+id/tvPageInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1/1"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginHorizontal="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextPage"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="下一页"
                        android:textSize="11sp"
                        android:minHeight="0dp"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="12dp"
                        app:cornerRadius="16dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:paddingVertical="4dp" />

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
