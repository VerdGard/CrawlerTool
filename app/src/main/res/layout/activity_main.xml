<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context="com.SoloSu.Crawler_tool.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="4dp"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/status_bar_color"
            app:title="Crawler Tool"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:titleTextColor="@color/md_on_surface"
            app:menu="@menu/toolbar_menu" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:paddingTop="4dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 输入卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clipToOutline="true"
            app:cardElevation="3dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke"
            app:contentPadding="12dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 模式选择 -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/modeChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:chipSpacing="6dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeXPath"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_xpath"
                        android:checked="true"
                        app:chipBackgroundColor="@color/chip_bg"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/chip_stroke" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeCss"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_css"
                        app:chipBackgroundColor="@color/chip_bg"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/chip_stroke" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeRegex"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_regex"
                        app:chipBackgroundColor="@color/chip_bg"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/chip_stroke" />

                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/urlInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:hintEnabled="true"
                    app:boxBackgroundColor="@color/input_bg"
                    app:boxStrokeWidth="1.5dp"
                    android:hint="@string/hint_url">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/exprInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:hintEnabled="true"
                    app:boxBackgroundColor="@color/input_bg"
                    app:boxStrokeWidth="1.5dp"
                    android:hint="@string/hint_xpath">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExpression"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 快捷属性标签(仅 XPath 模式显示) -->
                <TextView
                    android:id="@+id/tvQuickAttrs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_quick_attrs"
                    android:textSize="12sp"
                    android:textColor="@color/md_on_surface_variant"
                    android:layout_marginBottom="4dp" />

                <HorizontalScrollView
                    android:id="@+id/quickAttrScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:scrollbars="none"
                    android:overScrollMode="ifContentScrolls">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/quickAttrChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:chipSpacing="4dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTitle"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="title"
                            android:textSize="11sp"
                            android:textColor="@color/chip_text"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:chipBackgroundColor="@color/chip_bg"
                            app:chipStrokeWidth="1dp"
                            app:chipStrokeColor="@color/chip_stroke"
                            app:chipMinTouchTargetSize="28dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipHref"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="href"
                            android:textSize="11sp"
                            android:textColor="@color/chip_text"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:chipBackgroundColor="@color/chip_bg"
                            app:chipStrokeWidth="1dp"
                            app:chipStrokeColor="@color/chip_stroke"
                            app:chipMinTouchTargetSize="28dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDataOriginal"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="data-original"
                            android:textSize="11sp"
                            android:textColor="@color/chip_text"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:chipBackgroundColor="@color/chip_bg"
                            app:chipStrokeWidth="1dp"
                            app:chipStrokeColor="@color/chip_stroke"
                            app:chipMinTouchTargetSize="28dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDataSrc"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="data-src"
                            android:textSize="11sp"
                            android:textColor="@color/chip_text"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:chipBackgroundColor="@color/chip_bg"
                            app:chipStrokeWidth="1dp"
                            app:chipStrokeColor="@color/chip_stroke"
                            app:chipMinTouchTargetSize="28dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipText"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="text()"
                            android:textSize="11sp"
                            android:textColor="@color/chip_text"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:chipBackgroundColor="@color/chip_bg"
                            app:chipStrokeWidth="1dp"
                            app:chipStrokeColor="@color/chip_stroke"
                            app:chipMinTouchTargetSize="28dp" />

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

                <!-- 批量抓取折叠区 -->
                <LinearLayout
                    android:id="@+id/batchSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:padding="8dp"
                    android:background="@color/input_bg"
                    android:clipToOutline="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/batch_title"
                        android:textSize="13sp"
                        android:textColor="@color/md_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:hint="@string/batch_start_page"
                            app:boxBackgroundColor="@color/input_bg">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBatchStart"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:hint="@string/batch_end_page"
                            app:boxBackgroundColor="@color/input_bg">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBatchEnd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:hint="@string/batch_url_pattern"
                        app:boxBackgroundColor="@color/input_bg">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBatchUrlPattern"

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBatchStart"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="开始批量抓取"
                        android:textSize="12sp"
                        android:minHeight="0dp"
                        app:cornerRadius="18dp"
                        app:backgroundTint="@color/md_primary"
                        android:textColor="@color/md_on_primary" />
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:singleLine="true"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- 操作按钮行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMatch"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/btn_match"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        app:cornerRadius="22dp"
                        app:backgroundTint="@color/md_primary"
                        android:textColor="@color/md_on_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBatch"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="批量"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        app:cornerRadius="22dp"
                        app:backgroundTint="@color/md_tertiary"
                        android:textColor="@color/md_on_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPasteUrl"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="粘贴URL"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        app:cornerRadius="22dp"
                        app:backgroundTint="@color/md_primary_container"
                        android:textColor="@color/md_on_primary_container" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShare"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="分享"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        app:cornerRadius="22dp"
                        app:backgroundTint="@color/md_secondary"
                        android:textColor="@color/md_on_primary" />
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="@string/btn_clear"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        app:cornerRadius="22dp"
                        app:backgroundTint="@color/md_error"
                        android:textColor="@color/md_on_primary"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 结果卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="4dp"
            android:clipToOutline="true"
            app:cardElevation="3dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke"
            app:contentPadding="10dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvResultTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="匹配结果"
                        android:textSize="14sp"
                        android:textColor="@color/md_on_surface"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_copy_rule"
                        android:textSize="11sp"
                        android:minHeight="0dp"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="12dp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/md_primary_container"
                        android:textColor="@color/md_on_primary_container" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/divider_color"
                    android:layout_marginBottom="6dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerResult"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:padding="2dp"
                    android:overScrollMode="ifContentScrolls"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- 分页控制 -->
                <LinearLayout
                    android:id="@+id/paginationBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone"
                    android:paddingTop="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrevPage"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="上一页"
                        android:textSize="11sp"
                        android:minHeight="0dp"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="12dp"
                        app:cornerRadius="16dp" />

                    <TextView
                        android:id="@+id/tvPageInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1/1"
                        android:textSize="12sp"
                        android:textColor="@color/md_on_surface"
                        android:layout_marginHorizontal="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextPage"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="下一页"
                        android:textSize="11sp"
                        android:minHeight="0dp"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="12dp"
                        app:cornerRadius="16dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/md_on_surface_variant"
            android:gravity="center"
            android:paddingVertical="4dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
