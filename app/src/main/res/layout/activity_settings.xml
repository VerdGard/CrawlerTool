<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="4dp"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/status_bar_color"
            app:title="@string/settings_title"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:titleTextColor="@color/md_on_surface"
            app:navigationIcon="?attr/homeAsUpIndicator" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- User-Agent 设置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_user_agent"
                        android:textSize="16sp"
                        android:textColor="@color/md_on_surface"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="@color/input_bg">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUserAgent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textSize="12sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 连接超时 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_connect_timeout"
                        android:textSize="16sp"
                        android:textColor="@color/md_on_surface"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvConnectTimeout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15 秒"
                        android:textSize="14sp"
                        android:textColor="@color/md_primary"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderConnectTimeout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="5"
                        android:valueTo="60"
                        android:value="15"
                        android:stepSize="5" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 读取超时 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_read_timeout"
                        android:textSize="16sp"
                        android:textColor="@color/md_on_surface"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvReadTimeout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 秒"
                        android:textSize="14sp"
                        android:textColor="@color/md_primary"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderReadTimeout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="10"
                        android:valueTo="120"
                        android:value="30"
                        android:stepSize="5" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 保存历史 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSaveHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_save_history"
                        android:textColor="@color/md_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- 语言设置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_language"
                        android:textSize="16sp"
                        android:textColor="@color/md_on_surface"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />
                    <RadioGroup
                        android:id="@+id/radioGroupLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/radioLangZh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_language_zh"
                            android:textColor="@color/md_on_surface"
                            android:checked="true" />
                        <RadioButton
                            android:id="@+id/radioLangEn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_language_en"
                            android:textColor="@color/md_on_surface" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- 自定义请求头 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_custom_headers"
                        android:textSize="16sp"
                        android:textColor="@color/md_on_surface"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/tvHeaderCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="暂无自定义请求头"
                        android:textSize="13sp"
                        android:textColor="@color/md_on_surface_variant"
                        android:layout_marginBottom="8dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManageHeaders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="管理请求头"
                        android:textSize="12sp"
                        android:minHeight="0dp"
                        android:paddingVertical="6dp"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- JS渲染 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_js_render"
                        android:textSize="16sp"
                        android:textColor="@color/md_on_surface"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_js_render_summary"
                        android:textSize="12sp"
                        android:textColor="@color/md_on_surface_variant"
                        android:layout_marginBottom="8dp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchJsRender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="启用JS渲染"
                        android:textColor="@color/md_on_surface" />
                    <TextView
                        android:id="@+id/tvJsDelay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 秒"
                        android:textSize="14sp"
                        android:textColor="@color/md_primary"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderJsDelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1"
                        android:valueTo="10"
                        android:value="3"
                        android:stepSize="1"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- 代理设置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_proxy"
                        android:textSize="16sp"
                        android:textColor="@color/md_on_surface"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchProxy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_proxy_enable"
                        android:textColor="@color/md_on_surface" />
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProxyHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/settings_proxy_host"
                        android:inputType="text"
                        android:singleLine="true"
                        android:visibility="gone" />
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProxyPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/settings_proxy_port"
                        android:inputType="number"
                        android:singleLine="true"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- 失败重试次数 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_batch_retry"
                        android:textSize="16sp"
                        android:textColor="@color/md_on_surface"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/tvRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 次"
                        android:textSize="14sp"
                        android:textColor="@color/md_primary"
                        android:layout_marginBottom="8dp" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRetry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="5"
                        android:value="1"
                        android:stepSize="1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- 批量请求延迟 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_batch_delay"
                        android:textSize="16sp"
                        android:textColor="@color/md_on_surface"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/tvBatchDelay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="无延迟"
                        android:textSize="14sp"
                        android:textColor="@color/md_primary"
                        android:layout_marginBottom="8dp" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderBatchDelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="5000"
                        android:value="0"
                        android:stepSize="500" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- 默认主题 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_theme"
                        android:textSize="16sp"
                        android:textColor="@color/md_on_surface"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radioThemeSystem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_theme_system"
                            android:textColor="@color/md_on_surface"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/radioThemeLight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_theme_light"
                            android:textColor="@color/md_on_surface" />

                        <RadioButton
                            android:id="@+id/radioThemeDark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_theme_dark"
                            android:textColor="@color/md_on_surface" />

                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
